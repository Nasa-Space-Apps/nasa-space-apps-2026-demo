{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "linea_de_tiempo_mision_v2",
 "title": "Línea de tiempo de una misión espacial (esquema 2.0)",
 "type": "object",
 "required": [
  "esquema_version",
  "mision",
  "titulo",
  "idioma",
  "generado",
  "version",
  "alcance",
  "como_leer",
  "aviso_verificacion",
  "ficha_tecnica",
  "equipo",
  "totales_de_la_mision",
  "records",
  "discrepancias",
  "pendientes_de_verificar",
  "recursos_para_la_plataforma",
  "eventos",
  "fuentes_no_citadas_en_eventos",
  "indice_fuentes"
 ],
 "properties": {
  "esquema_version": {
   "const": "2.0"
  },
  "mision": {
   "type": "object",
   "required": [
    "id",
    "nombre",
    "nombre_completo",
    "agencia",
    "tipo",
    "cuerpo",
    "lugar",
    "estado_actual",
    "sol_cero",
    "fechas_clave",
    "misiones_relacionadas",
    "resumen"
   ]
  },
  "idioma": {
   "const": "es"
  },
  "ficha_tecnica": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "valor",
     "fuentes"
    ],
    "properties": {
     "valor": {},
     "nota": {
      "type": "string"
     },
     "fuentes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/fuente"
      }
     }
    }
   }
  },
  "totales_de_la_mision": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "valor",
     "fuentes"
    ],
    "properties": {
     "valor": {},
     "nota": {
      "type": "string"
     },
     "fuentes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/fuente"
      }
     }
    }
   }
  },
  "equipo": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "nombre",
     "rol",
     "fuentes"
    ],
    "properties": {
     "fuentes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/fuente"
      }
     }
    }
   }
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "descripcion",
     "fuentes"
    ],
    "properties": {
     "fuentes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/fuente"
      }
     }
    }
   }
  },
  "discrepancias": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "tema",
     "valores",
     "recomendacion",
     "fuentes"
    ],
    "properties": {
     "valores": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "fuentes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/fuente"
      }
     }
    }
   }
  },
  "pendientes_de_verificar": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "recursos_para_la_plataforma": {
   "type": "object",
   "properties": {
    "modelos_3d": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "imagenes_y_panoramicas": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "vistas_desde_orbita": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "videos": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "documentales": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "datos": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "educacion": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "historias": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    },
    "portales": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "nombre",
       "url"
      ],
      "properties": {
       "nombre": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
       }
      }
     }
    }
   }
  },
  "eventos": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "orden",
     "fecha_inicio",
     "fecha_fin",
     "precision_fecha",
     "sol",
     "sol_texto",
     "titulo",
     "detalle",
     "datos_clave",
     "etapa",
     "fase",
     "categoria",
     "respaldo",
     "discutido",
     "nota",
     "fuentes",
     "compartido_con",
     "datos_extra"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,5}\\d{3}$"
     },
     "orden": {
      "type": "integer",
      "minimum": 1
     },
     "fecha_inicio": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
     },
     "fecha_fin": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
     },
     "precision_fecha": {
      "enum": [
       "año",
       "mes",
       "día",
       "rango",
       "aproximada",
       "década"
      ]
     },
     "sol": {
      "type": [
       "integer",
       "null"
      ]
     },
     "sol_texto": {
      "type": [
       "string",
       "null"
      ]
     },
     "titulo": {
      "type": "string",
      "minLength": 3
     },
     "detalle": {
      "type": "string",
      "minLength": 10
     },
     "datos_clave": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "etapa": {
      "type": "string"
     },
     "fase": {
      "enum": [
       "origen",
       "planificacion_y_desarrollo",
       "lanzamiento_y_viaje",
       "aterrizaje",
       "operaciones",
       "fin_de_mision",
       "legado"
      ]
     },
     "categoria": {
      "enum": [
       "origen",
       "planificacion",
       "desarrollo",
       "pruebas",
       "lanzamiento",
       "viaje",
       "aterrizaje",
       "despliegue",
       "operacion",
       "ciencia",
       "problema",
       "solucion",
       "hito",
       "fin_de_mision",
       "legado"
      ]
     },
     "respaldo": {
      "enum": [
       "oficial_o_cientifico",
       "secundario",
       "sin_fuente"
      ]
     },
     "discutido": {
      "type": "boolean"
     },
     "nota": {
      "type": [
       "string",
       "null"
      ]
     },
     "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "#/$defs/fuente"
      }
     },
     "compartido_con": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "datos_extra": {
      "type": [
       "object",
       "array",
       "null"
      ]
     }
    }
   }
  },
  "fuentes_no_citadas_en_eventos": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/fuente"
   }
  },
  "indice_fuentes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "url",
     "titulo",
     "tipo",
     "verificacion",
     "eventos"
    ]
   }
  }
 },
 "$defs": {
  "fuente": {
   "type": "object",
   "required": [
    "titulo",
    "url",
    "tipo",
    "verificacion"
   ],
   "additionalProperties": false,
   "properties": {
    "titulo": {
     "type": "string",
     "minLength": 1
    },
    "editor": {
     "type": [
      "string",
      "null"
     ]
    },
    "url": {
     "type": "string",
     "pattern": "^https?://\\S+$"
    },
    "tipo": {
     "enum": [
      "oficial NASA/JPL",
      "científica",
      "prensa",
      "comunitaria",
      "libro/medio",
      "video/audio"
     ]
    },
    "verificacion": {
     "enum": [
      "página abierta completa",
      "página abierta (resumen automático de la herramienta)",
      "solo extracto de búsqueda"
     ]
    },
    "nota": {
     "type": "string"
    }
   }
  }
 }
}