# Copia este archivo a .env (ignorado por git). No pongas claves de AWS aquí: salen de tu perfil de la CLI.

# Proveedor del modelo: plan | api | bedrock. Si lo dejas vacío: api si hay ANTHROPIC_API_KEY, si no plan.
PROVEEDOR_LLM=

# Si el proveedor (p. ej. bedrock) falla ANTES de empezar el trabajo, reintentar con el plan de Claude (1 = sí).
FALLBACK_PLAN=

# --- plan de Claude: solo `claude login`, sin variables.

# --- API key de Anthropic
ANTHROPIC_API_KEY=
# Tope por evento (aplica a api y bedrock).
PRESUPUESTO_USD=2.0
MODELO_INVESTIGADOR=claude-sonnet-5-5

# --- Amazon Bedrock (las credenciales vienen del perfil de la CLI de AWS)
AWS_REGION=us-east-1
BEDROCK_PROFILE=default
# IDs de perfiles de inferencia; estos son los valores por defecto (verificados).
# Revisor (segunda pasada, solo Bedrock): relee el borrador de Sonnet. "ninguno" lo desactiva.
BEDROCK_MODELO_REVISOR=us.anthropic.claude-opus-4-6-v1
# Para usar la familia 5.5 (cuando AWS acepte el pago): us.anthropic.claude-sonnet-5-5 y us.anthropic.claude-haiku-5-5
BEDROCK_MODELO=us.anthropic.claude-sonnet-4-6
BEDROCK_MODELO_PEQUENO=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Opcional: correo o URL tuyos para habilitar Wikipedia (Wikimedia lo exige).
WIKIMEDIA_CONTACT=
