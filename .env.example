# Copy to .env.local. Only needed to (re)record audio with `npm run narration` / `npm run guide`:
# the app itself never calls ElevenLabs at runtime (it plays the mp3 files in public/narration).
# Server/script-side only: NEVER prefix with NEXT_PUBLIC_.

# ElevenLabs API key. If it is scoped, it needs the Text-to-Speech permission.
ELEVENLABS_API_KEY=

# Optional overrides (defaults live in scripts/generate-narration.mjs)
# ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4
# ELEVENLABS_VOICE_NAME=Bill
# ELEVENLABS_MODEL_ID=eleven_v4
# Voice guide (npm run guide)
# ELEVENLABS_GUIDE_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_GUIDE_VOICE_NAME=Daniel
# ELEVENLABS_GUIDE_MODEL_ID=eleven_flash_v2_5

# Replicate (scripts/generate-story-images.mjs: illustrations with Nano Banana). Only the script uses it, never the app.
REPLICATE_API_KEY=
